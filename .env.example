# Clair-Obscur - Configuration d'environnement
# Copiez ce fichier en .env et modifiez les valeurs

# Base de données
DB_HOST=localhost
DB_NAME=clair-obscur
DB_USER=clair-obscur
DB_PASS=votre_mot_de_passe

# Site
SITE_NAME="Clair-Obscur Éditions"
SITE_URL=https://clair-obscur-editions.com/
ADMIN_EMAIL=contact@clair-obscur-editions.com

# PayPal
PAYPAL_CLIENT_ID=VOTRE_CLIENT_ID_ICI
PAYPAL_SECRET=VOTRE_SECRET_ICI
PAYPAL_MODE=sandbox

# reCAPTCHA
RECAPTCHA_SITE_KEY=VOTRE_CLE_SITE
RECAPTCHA_SECRET_KEY=VOTRE_CLE_SECRETE

# n8n Chat
N8N_WEBHOOK_URL=https://votre-instance.app.n8n.cloud/webhook/xxx/chat

# Google Analytics
GA_TRACKING_ID=G-XXXXXXXXXX

# Debug (true/false)
DEBUG_MODE=false
